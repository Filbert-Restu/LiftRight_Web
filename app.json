{
  "expo": {
    "name": "LiftRight",
    "slug": "liftright",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "liftrightweb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "LiftRight terhubung ke sensor punggung lewat Bluetooth untuk memantau data latihan."
      }
    },
    "android": {
      "package": "com.liftright.app",
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "LiftRight membutuhkan izin Bluetooth untuk terhubung ke unit sensor punggung."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7ddc576-8cfc-4aaf-bc1d-b4577b0c3537"
      }
    }
  }
}